# Dual-Key Task Isolation (Orbit Architecture)
GEMINI_ORCHESTRATOR_KEY=your_project_a_orchestrator_key
GEMINI_WORKER_KEY=your_project_b_worker_key
GOOGLE_API_KEY=your_fallback_key

# Models
GEMINI_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001
WORKER_AUDIT_MODEL=gemini-3.5-flash

# Backend & Database Configuration
# For PostgreSQL (Docker / Production):
DATABASE_URL=postgresql://orbit:orbit_password@localhost:5432/orbit_db
# For SQLite (Local development / Pytest fallback):
DATABASE_PATH=chatbot.db

ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost"]
COOKIE_SECURE=false
SESSION_DAYS=7
